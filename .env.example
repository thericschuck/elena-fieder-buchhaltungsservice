# Resend – Versand des Kontaktformulars
# Kopie als .env.local anlegen und ausfuellen. .env.local ist bereits gitignored.

# API-Key aus https://resend.com/api-keys (beginnt mit re_)
RESEND_API_KEY=

# Absenderadresse. Die Domain muss in Resend verifiziert sein,
# sonst lehnt der Versand ab. elena-fieder.de muss dort also verifiziert werden.
KONTAKT_ABSENDER="Elena Fieder Buchhaltungsservice <noreply@elena-fieder.de>"

# Postfach, in dem die Anfragen ankommen sollen.
KONTAKT_EMPFAENGER=info@elena-fieder.de
